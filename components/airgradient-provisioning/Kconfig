menu "AirGradient Provisioning"

    config AG_PROVISIONING_DEFAULT_OVERALL_TIMEOUT_MS
        int "Default inactivity timeout (ms)"
        range 0 3600000
        default 0
        help
            Default value used when a product does not explicitly set
            ProvisioningConfig::overall_timeout_ms. 0 disables the
            inactivity timeout entirely.

endmenu
